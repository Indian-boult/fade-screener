# Copy to .env and fill in. Never commit .env.

# DeepSeek — required for the ask command (python screener.py --ask "...").
# Set it in your terminal (export DEEPSEEK_API_KEY=...); it is read from the
# environment at run time and never printed, logged, or stored in this folder.
DEEPSEEK_API_KEY=

# Dhan API credentials — currently UNUSED: no code path calls the Dhan
# market-data API any more. Kept only because fade_backtest.py's legacy
# universe loader still reads DHAN_ACCESS_TOKEN (the value is ignored — the
# stock list comes from the public scrip-master CSV). Safe to leave blank.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_TOTP_SECRET=
DHAN_PIN=
